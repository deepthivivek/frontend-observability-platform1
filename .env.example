# GEMINI_API_KEY: Required for server-side Gemini PromQL / AI SRE calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Backend Ingestion Gateway & Security Broker
PORT="4000"
NODE_ENV="development"
MAX_WORKERS="8"
BACKEND_GATEWAY_URL=""

# Cryptographic & Post-Quantum Seeds (inject from KMS/Secrets Manager in production)
JWT_SECRET="neon_chasm_jwt_enterprise_master_secret_key_32chars"
PQC_LATTICE_SEED="pqc_ml_kem_1024_seed_key_64"
ENCRYPTION_MASTER_KEY="fhe_aes256_gcm_master_vault_key_32bytes"

# Multi-Tenant API Key Authentication & Token-Bucket Rate Limiting
TENANT_AUTH_REQUIRED="false"
TENANT_API_KEYS=""
RATE_LIMIT_BURST="240"
RATE_LIMIT_RPS="60"

# Atomic WAL Persistence & Telemetry Retention
NEON_CHASM_STATE_DIR="/tmp/neon-chasm-state"
TELEMETRY_RETENTION_HOURS="168"
TELEMETRY_BUFFER_MAX="2000"

# OpenTelemetry Collector Integration
OTEL_SERVICE_NAME="neon-chasm-observability"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# Frontend Real-Time Telemetry Stream Endpoints (optional overrides)
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_WS_URL=""
