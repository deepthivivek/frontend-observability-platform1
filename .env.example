# GEMINI_API_KEY: Required for server-side Gemini PromQL / AI SRE calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Core Runtime & Multi-Tenant Session Signing
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
# REQUIRED when NODE_ENV="production" (>= 32 chars; generate with: openssl rand -hex 32)
# Also used via HKDF to derive AES-256-GCM keys for TOTP secrets & encrypted webhook URLs
SESSION_SECRET="replace_with_a_64_char_random_hex_session_signing_secret_in_prod"
# Sliding idle session timeout (default 30m) and absolute lifetime (default 24h)
SESSION_IDLE_TTL_MS="1800000"
SESSION_ABSOLUTE_TTL_MS="86400000"

# Persistent Multi-Tenant Auth & Telemetry Storage
# Used by Docker and Next.js server store (falls back to os.tmpdir()/neon-chasm-state)
DATA_DIR="./data"
NEON_CHASM_STATE_DIR="./data"

# Per-Tenant Ingestion Guardrails & Token-Bucket Rate Limiting
DEFAULT_TENANT_RATE_LIMIT_RPS="1000"
RATE_LIMIT_RPS="100"
RATE_LIMIT_BURST="240"

# Backend Ingestion Gateway & Cryptographic Seeds (optional standalone gateway mode)
BACKEND_GATEWAY_URL=""
JWT_SECRET="neon_chasm_jwt_enterprise_master_secret_key_32chars"
PQC_LATTICE_SEED="pqc_ml_kem_1024_seed_key_64"
ENCRYPTION_MASTER_KEY="fhe_aes256_gcm_master_vault_key_32bytes"
TELEMETRY_RETENTION_HOURS="168"
TELEMETRY_BUFFER_MAX="2000"

# OpenTelemetry Collector Integration
OTEL_SERVICE_NAME="neon-chasm-observability"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# Frontend Real-Time Telemetry Stream Endpoints (optional overrides)
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_WS_URL=""
